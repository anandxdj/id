# Copy to `.env` on the VPS. Never commit the populated file.
# Use `latest` for automatic upgrades, or pin a published version for rollback.
BACKEND_VERSION=latest

# Include a database name in the Atlas URI or set MONGO_DB_NAME separately.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=id

# `honcho-redis` is resolved over the shared Docker network below.
REDIS_URL=redis://honcho-redis:6379

# Required by the backend in production.
OIDC_ISSUER=https://id.example.com
CORS_ORIGIN=https://app.example.com
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-a-different-value-with-openssl-rand-hex-32>
KEY_ENCRYPTION_SECRET=<existing-deployment-value>
COOKIE_SECURE=true
OIDC_RSA_PRIVATE_KEY_PATH=./cert/private-key.pem
OIDC_KEY_ENCRYPTION_KEY=<generate-and-keep-stable>
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=id <no-reply@example.com>
