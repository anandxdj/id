# =============================================================================
#  id — backend environment
# =============================================================================
#  Every variable below is parsed and validated once at boot by
#  src/common/config/env.ts. A misconfigured deployment fails immediately with
#  every problem listed at once — it never starts and 500s on first login.
#
#  Copy to `.env` and fill in. Variables marked REQUIRED IN PROD are optional
#  locally (a safe development default is used) but hard-fail when
#  NODE_ENV=production.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Number of reverse proxies in front of this process. Drives Express `trust proxy`,
# which is what makes rate limiting see the real client IP instead of the proxy's.
# Set to the ACTUAL hop count — too high lets a caller spoof X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Grace period for in-flight requests to finish on SIGTERM before sockets are destroyed.
SHUTDOWN_TIMEOUT_MS=10000
# debug | info | warn | error | silent
LOG_LEVEL=info

# ── Datastores ───────────────────────────────────────────────────────────────
# Ports are offset from the defaults (see docker-compose.yml) so this stack cannot
# collide with another project's database on a shared dev machine — a collision
# connects successfully and writes into a stranger's server.
#
# REQUIRED IN PROD. Mongo runs as a single-member replica set; `?replicaSet=rs0` is
# mandatory, since transactions and change streams do not exist on a standalone.
MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGO_DB_NAME=id
# Redis is a CACHE AND COUNTER layer only: distributed rate limiting, login throttles,
# and read caches. Nothing may live here as its only copy — losing Redis must cost
# latency, never a user's session. Authoritative state belongs in Mongo.
REDIS_URL=redis://127.0.0.1:6380

# ── Retention ────────────────────────────────────────────────────────────────
# Activity-log retention in days. A TTL index drops events past this age; changing
# the value is reconciled against the live index at boot.
EVENT_RETENTION_DAYS=90

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# REQUIRED IN PROD: set CORS_ORIGINS or FRONTEND_URL. The allowlist FAILS CLOSED —
# it is never permitted to be empty, because this API is called with credentials
# and an empty allowlist previously meant "reflect any Origin", i.e. every site on
# the internet could read an authenticated user's identity data.
FRONTEND_URL=http://localhost:3000
# Comma-separated. Use this (not FRONTEND_URL) when more than one origin is served.
# CORS_ORIGINS=https://app.anands.dev,https://admin.anands.dev
# Where the OIDC flow sends users to log in / consent. Both default to FRONTEND_URL.
OIDC_LOGIN_REDIRECT_BASE=http://localhost:3000
OIDC_CONSENT_REDIRECT_BASE=http://localhost:3000

# ── First-party session JWTs (NOT the OIDC ID token) ─────────────────────────
# REQUIRED IN PROD, min 32 chars, and the two MUST differ — a shared secret lets a
# refresh token be replayed as an access token. Generate with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# NOTE (M3): this no longer sizes the first-party refresh token. A refresh token's window
# is the session's own lifetime, and a rotated child inherits its parent's expiry — which
# is what keeps the window absolute instead of sliding forward on every refresh. The
# setting is retained for the OIDC paths that still read it.
JWT_REFRESH_EXPIRES_IN=7d
# REQUIRED IN PROD (must be true). The refresh cookie is a session credential; over
# plain HTTP it is readable by any network observer.
COOKIE_SECURE=false
# Set only when sharing the cookie across subdomains, e.g. .anands.dev
# COOKIE_DOMAIN=.anands.dev

# ── OIDC issuer + RSA signing key (ID token, RS256) ──────────────────────────
# REQUIRED IN PROD. The public issuer URL, baked into the `iss` claim of every token
# issued — changing it invalidates all outstanding tokens. No trailing slash.
OIDC_ISSUER=http://localhost:4000
# Advertised as `kid` in JWKS so clients can pick the right key during rotation.
OIDC_KEY_ID=oidc-1
# REQUIRED IN PROD: provide ONE of the two below, or drop a PEM at
# backend/cert/private-key.pem. Without one, each process generates an EPHEMERAL key,
# so tokens signed by one replica fail verification on another and every restart
# silently invalidates all issued tokens.
# OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OIDC_RSA_PRIVATE_KEY_PATH=./cert/private-key.pem

# ── Social login connectors (adapter pattern) ────────────────────────────────
# A connector is enabled only when BOTH its id and secret are present. AUTH_CONNECTORS
# optionally narrows to a subset even when more are configured; leave unset to enable
# everything that is configured.
# AUTH_CONNECTORS=google,github
#
# Google — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:4000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub — https://github.com/settings/developers
#   Authorization callback URL: http://localhost:4000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Password hashing (Argon2id) ──────────────────────────────────────────────
# Cost is a per-deployment tuning decision, not a code constant: a box that must sustain
# 50 logins/s cannot use the same memory cost as one serving 5. Defaults are the
# OWASP-current values (64 MiB, t=3, p=4) and are validated against a floor, because a
# mistyped ARGON2_MEMORY_KIB=64 fails silently — every password still hashes, at roughly a
# thousandth of the intended cost.
#
# Raising any of these is safe and takes effect gradually: each user's next successful
# login rehashes their stored digest at the new cost (`PasswordService.needsRehash`).
# The measured hash time is logged at boot; budget for it appearing on every login.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
#
# SET THIS DELIBERATELY. Argon2's async API runs on libuv's thread pool, which defaults to
# FOUR threads and is shared with dns.lookup, fs, zlib and crypto.pbkdf2. Measured here:
# with the default pool, a file read that takes 0 ms idle takes 182 ms while eight hashes
# are in flight; at 16 threads it returns in 0 ms. Since Mongo and Redis reconnects need
# dns.lookup, an undersized pool lets a login burst delay the reconnect that would end an
# outage. Rule of thumb: expected concurrent logins + headroom for the runtime's own work.
# libuv reads this once, before any application code runs, so it cannot be set from config.
UV_THREADPOOL_SIZE=8

# ── Transactional email (Resend) ─────────────────────────────────────────────
# REQUIRED IN PROD (both). Email is load-bearing since M2: a reset link is the only account
# recovery path there is, so booting production without a provider ships a register page
# that mints accounts nobody can ever verify or recover.
#
# While unset outside production, nothing leaves the process and NO TOKEN IS EVER LOGGED.
# Suppressed messages are captured in a bounded in-memory outbox and readable at
#   GET /api/v1/auth/dev/outbox?to=<address>
# which is how you get a verification or reset link locally. That endpoint 404s as soon as a
# provider is configured, and always in production.
RESEND_API_KEY=
EMAIL_FROM="id <no-reply@id.anands.dev>"

# ── Sessions / refresh tokens (M3) ───────────────────────────────────────────
# Blast radius when a refresh token is replayed outside its grace window — theft, or a
# cloned client.
#
# false (default): kill the offending family and the session it belongs to. Proportionate,
# because the compromise is scoped to one login, and a false positive costs the user one
# device rather than all of them.
#
# true: any reuse anywhere signs the account out everywhere. Defensible for a high-value
# tenant; a poor default, because it makes every false positive catastrophic and punishes
# a user whose other devices are demonstrably fine.
REFRESH_REUSE_REVOKES_ALL_SESSIONS=false

# ── Seed (internal provisioning, `pnpm seed:admin`) ──────────────────────────
SEED_ADMIN_EMAIL=darkjargon739@gmail.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=
