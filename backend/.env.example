# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Datastores ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=id
REDIS_URL=redis://127.0.0.1:6379

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Where the OIDC flow sends users to log in / consent (defaults to FRONTEND_URL)
OIDC_LOGIN_REDIRECT_BASE=http://localhost:3000
OIDC_CONSENT_REDIRECT_BASE=http://localhost:3000

# ── First-party session JWTs (NOT the OIDC ID token) ──────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OIDC issuer + RSA signing key (ID token, RS256) ───────────────────────────
# Public issuer URL clients use. No trailing slash. Defaults to http://localhost:PORT
OIDC_ISSUER=http://localhost:4000
OIDC_KEY_ID=oidc-1
# Provide ONE of: inline PEM (\n-escaped), a path, or drop backend/cert/private-key.pem
# OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# OIDC_RSA_PRIVATE_KEY_PATH=./cert/private-key.pem

# ── Social login connectors (adapter pattern) ────────────────────────────────
# A connector is enabled when its credentials are present. AUTH_CONNECTORS optionally
# restricts to a subset even if more are configured (leave unset to enable all configured).
# AUTH_CONNECTORS=google,github
#
# Google: create OAuth credentials at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:4000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: create an OAuth App at https://github.com/settings/developers
#   Authorization callback URL: http://localhost:4000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Seed (internal provisioning) ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=bilal@tabbio.com
SEED_ADMIN_NAME=Bilal
SEED_ADMIN_PASSWORD=change-me-strong-password
