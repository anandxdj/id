{
  "name": "id-backend",
  "version": "1.0.0",
  "description": "Internal OIDC provider — universal SSO",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "cross-env UV_THREADPOOL_SIZE=8 tsx watch index.ts",
    "start": "cross-env UV_THREADPOOL_SIZE=8 tsx index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist --module commonjs --moduleResolution node --verbatimModuleSyntax false --allowImportingTsExtensions false && node -e \"require('node:fs').writeFileSync('dist/package.json',JSON.stringify({type:'commonjs'}))\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "oidc:generate-keys": "bash scripts/generate-oidc-keys.sh",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:clients": "tsx scripts/seed-clients.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "node-jose": "^2.2.0",
    "rate-limit-redis": "^4.3.1",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/node-jose": "^1.1.13",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.33.2"
}
