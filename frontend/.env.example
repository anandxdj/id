# Base URL of the id backend (OIDC provider API)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: GIF(s) masking the light/dark theme swap (View Transition).
# One URL, or several comma-separated — one is picked at random per swap.
# High-contrast GIFs work best. Leave empty for the circle-blur reveal fallback.
NEXT_PUBLIC_THEME_GIF_URL=
